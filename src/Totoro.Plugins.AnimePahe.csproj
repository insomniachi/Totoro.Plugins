<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Totoro.Plugins.AnimePahe</RootNamespace>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
    <!-- Reference Totoro.Core when local in workspace, otherwise use NuGet package -->
    <ProjectReference Include="..\..\src\Totoro.Core\Totoro.Core.csproj" Condition="Exists('..\..\src\Totoro.Core\Totoro.Core.csproj')" />
    <PackageReference Include="Totoro.Core" Version="2.0.0" Condition="!Exists('..\..\src\Totoro.Core\Totoro.Core.csproj')" />
  </ItemGroup>

  <!-- Package into .totoro-plugin on Release build -->
  <Target Name="PackTotoroPlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(TargetDir)..\Package" />
    <ZipDirectory SourceDirectory="$(TargetDir)" DestinationFile="$(TargetDir)..\Package\AnimePahe.totoro-plugin" Overwrite="true" />
  </Target>
</Project>
